{
  // The options both packages compile under. Anything naming a path --
  // `rootDir`, `outDir`, `tsBuildInfoFile`, `include` -- stays in the package
  // that owns the path: a path written here would resolve against the root.
  // Never compiled on its own; it only exists to be extended.
  "files": [],
  "compilerOptions": {
    // tsgolint resolves node: builtins to an error type acting as `any`
    // without this, which makes every type-aware rule blind to them.
    "types": ["node"],
    "noEmit": true,
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "preserve",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
