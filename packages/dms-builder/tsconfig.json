{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The engine suites are plain mocha specs; only this package compiles them.
    "types": ["node", "mocha"],
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/lint.tsbuildinfo",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["./src/**/*.ts"]
}
