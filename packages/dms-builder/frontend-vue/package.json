{
  "name": "@antelopejs/dms-builder-frontend-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "@antelopejs/dms-frontend": ">=0.10.0 <0.11.0"
  },
  "scripts": {
    "typecheck": "ajs dms verify-source --layer \"$PWD/node_modules/@antelopejs/dms/frontend-vue\" --module \"$PWD\"",
    "lint": "eslint . && node node_modules/@antelopejs/dms/frontend-vue/scripts/check-api-error-presentation.mjs app",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:components": "vitest run --config tests/components.config.ts"
  },
  "dependencies": {
    "@antelopejs/interface-dms": ">=0.12.0 <1.0.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@antelopejs/core": "1.21.0",
    "@antelopejs/dms": ">=0.17.0 <1.0.0",
    "@antelopejs/dms-frontend": ">=0.10.0 <1.0.0",
    "@antelopejs/interface-api": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.6.0 <1.0.0",
    "@antelopejs/interface-database": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.2.0 <1.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.1.1"
  }
}
