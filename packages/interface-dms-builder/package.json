{
  "name": "@antelopejs/interface-dms-builder",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-builder.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "docs"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "dist/*",
        "dist/*/index.d.ts"
      ],
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist": {
      "types": "./dist/index.d.ts"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "release": "release-it",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@antelopejs/interface-core": "^0.0.12",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.0.12 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {}
}
