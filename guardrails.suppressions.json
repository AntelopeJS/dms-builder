{
  "rules": {
    "anti-slop/no-unknown-type-aliases": 0
  },
  "tsExpectError": 2,
  "tsIgnore": 0,
  "safety": 1,
  "config": {
    "max-lines-per-function for packages/*/src/test/**/*.ts": 1,
    "no-redeclare for packages/dms-builder/frontend-vue/**/*.{ts,vue}": 1,
    "no-undef for packages/dms-builder/frontend-vue/**/*.{ts,vue}": 1,
    "no-unused-vars for packages/dms-builder/frontend-vue/**/*.{ts,vue}": 1,
    "unicorn/no-thenable for packages/*/src/test/**/*.ts": 1,
    "vue/multi-word-component-names for packages/dms-builder/frontend-vue/**/*.{ts,vue}": 1
  }
}
